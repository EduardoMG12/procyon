{
  "swagger": "2.0",
  "info": { "title": "Shop", "version": "1.0.0" },
  "securityDefinitions": { "key": { "type": "apiKey", "in": "header", "name": "X-Key" } },
  "security": [ { "key": [] } ],
  "paths": {
    "/users": {
      "post": {
        "parameters": [
          { "name": "trace", "in": "query", "type": "string" },
          {
            "name": "user",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "maxLength": 50 },
                "isAdmin": { "type": "boolean" }
              }
            }
          }
        ],
        "responses": { "201": { "description": "Created" } }
      }
    }
  }
}
